{
  "name": "ganjoor-pwa-proposal",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Beyt (بیت): an unofficial Persian-poetry reader built on Ganjoor's open data and public API",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "voice:server": "node --env-file-if-exists=.env.local server/voice.mjs",
    "android:sync": "vite build && cap sync android",
    "android:build": "npm run android:sync && node android/build-debug.mjs",
    "android:release": "npm run android:sync && node android/build-release.mjs",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.2",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@elevenlabs/client": "1.38.0",
    "@fontsource/markazi-text": "5.3.0",
    "@fontsource/noto-nastaliq-urdu": "5.3.0",
    "@fontsource/parastoo": "5.3.0",
    "preact": "11.2.0",
    "preact-iso": "2.12.2"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2",
    "@preact/preset-vite": "2.10.6",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1"
  }
}
